<section id="Contact" style="background-color: #000000;">
    <div class="container pt-5">
      <div>
       <div class="row ">
           <div class="col-lg-5 pb-5">
               <div>
                  <div class="text-left ">
           
                    <h3 class="font-color-contact pb-3 text-uppercase">We'd love to hear from you!</h3>
                  </div>
                   <form method="POST" action="/send" class="ContactForm">
                 
                      <div class="md-form mb-3 text-white">
                    
                        <label for="validationCustom01" class="form-label">Full Name :</label>
                        <input type="text" id="form34" name="name" class="form-control form-control-sm" required>          
                      </div>
              
                      <div class="md-form mb-3 text-white">
          
                        <label for="validationCustom01" class="form-label">Email :</label>
                        <input type="email" id="form29" name="email" class="form-control form-control-sm" required>
                      </div>
              
                      <div class="md-form mb-3 text-white">
         
                        <label for="validationCustom01" class="form-label">Contact Number :</label>
                        <input type="text" id="form32" name="phone" class="form-control form-control-sm" required>
                      </div>

                      <div class="md-form mb-3 text-white">
             
                        <label for="validationCustom01" class="form-label">Message :</label>
                        <textarea type="text" id="form8" name="message" class="md-textarea form-control form-control-sm" rows="4" required></textarea>
                      </div>
                  
                    <div class="d-flex justify-content-center">
                      <button type="submit" class="btn btn-send text-white ContactButton">Send</button>
                    </div>
                  </form>
               </div>            
           </div>
           <div class="col-lg-4 col-md-6 col-sm-6 col-6">
            <h3 class="font-color-contact pb-3 text-uppercase ">Contact Info</h3>
            <div class="text-light">
                <p>
                  <ul style="list-style-type: none; padding: 0px; padding-top: 9px;">
                    <li>Office 103,</li>
                    <li>White Crown Building,</li>
                    <li>Sheikh Zayed Road</li>
                  </ul>
                </p>
                <p class="">Tel: +971-4-5689834</p>
                <p class="m-0">P.O. Box 114836</p>
                <p class="">Dubai U.A.E.</p>
                <p class="">Email: info@premiumeventsmanagement.com</p>
            </div>
           </div>
           <div class="col-lg-3 col-md-6 col-sm-6 col-6">
            <h3 class="font-color-contact pb-3 text-uppercase ">Location</h3>
            <iframe class="map" src="https://maps.google.com/maps?q=white%20crown%20&t=&z=13&ie=UTF8&iwloc=&output=embed" frameborder="0" allowfullscreen="" aria-hidden="false" tabindex="0" data-gtm-yt-inspected-1_19="true"></iframe>
            <!-- style="border:0; height: 47vh;"  -->
           </div>
       </div>
    </div>
</section>



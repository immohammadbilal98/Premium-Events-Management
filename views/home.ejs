                    <h3 class="font-color-contact">Contact</h3>
                    <p class="fs-5 text-white">We'd love to hear from you!</p>
                  </div>
                   <form method="POST" action="/send">
                 
                      <div class="md-form mb-3 text-white">
                        <!-- <i class="fas fa-user prefix grey-text"></i> -->
                        <label data-error="wrong" data-success="right" for="form34">Name</label>
                        <input type="text" id="form34" name="name" class="form-control validate">          
                      </div>
              
                      <div class="md-form mb-3 text-white">
                        <!-- <i class="fas fa-envelope prefix grey-text"></i> -->
